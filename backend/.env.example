# ── Environment ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://geolint:geolint@localhost:5432/geolint
DATABASE_URL_SYNC=postgresql+psycopg2://geolint:geolint@localhost:5432/geolint
REDIS_URL=redis://localhost:6379/0

# ── File Storage ──────────────────────────────────────────────
STORAGE_DIR=/app/storage

# ── File Size Limits ──────────────────────────────────────────
KML_MAX_SIZE_BYTES=5242880        # 5 MB
ZIP_MAX_SIZE_BYTES=20971520       # 20 MB compressed
ZIP_MAX_EXTRACTED_BYTES=104857600 # 100 MB extracted

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
